{
  "name": "@platen-reports/designer",
  "version": "0.0.0",
  "description": "React report designer for Platen Reports: outline tree, scaled canvas, per-type inspector, JSON panel and preview. Framework-agnostic below the route \u2014 the host supplies translation, permissions and navigation.",
  "license": "Apache-2.0",
  "author": {
    "name": "Erik Huisman"
  },
  "homepage": "https://github.com/erikhuis/platen-reports#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikhuis/platen-reports.git",
    "directory": "packages/designer"
  },
  "bugs": {
    "url": "https://github.com/erikhuis/platen-reports/issues"
  },
  "keywords": [
    "reporting",
    "report-designer",
    "pdf",
    "react"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@platen-reports/model": "workspace:*",
    "lucide-react": "^0.400.0 || ^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "@mui/material": "^5 || ^6 || ^7",
    "@emotion/react": "^11",
    "@emotion/styled": "^11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^5.16.0",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
